#!ipxe
# Ubuntu 22.04 LTS (Jammy) Live Server - iPXE Boot Script  
# Using squashfs approach (smaller, faster than ISO)
# For use with Hydra Host bare-metal provisioning

set squashfs_url https://raw.githubusercontent.com/jjziets/hydrahost/main/ubuntu-22.04/filesystem.squashfs
set casper       https://raw.githubusercontent.com/jjziets/hydrahost/main/ubuntu-22.04/casper
# NoCloud seed (MUST end with /)
set seed_url     https://raw.githubusercontent.com/jjziets/hydrahost/main/ubuntu-22.04/autoinstall/

dhcp

:menu
menu Ubuntu 22.04 LTS Server - Console Selection
item s0  Serial ttyS0 (115200)
item s1  Serial ttyS1 (115200)
item vga VGA console
choose --timeout 10000 --default s1 sel || goto menu

# Escape ';' in iPXE with '\;'
# Boot from squashfs directly (smaller download than ISO)
set common_args boot=casper netboot=url url=${squashfs_url} ip=dhcp autoinstall ds=nocloud-net\;s=${seed_url}

:s0
set cons console=ttyS0,115200n8
goto boot
:s1
set cons console=ttyS1,115200n8
goto boot
:vga
set cons console=tty0
goto boot

:boot
echo Booting Ubuntu 22.04 LTS with ${cons}
kernel ${casper}/vmlinuz ${common_args} ${cons} ---
initrd ${casper}/initrd
initrd https://raw.githubusercontent.com/jjziets/hydrahost/main/ubuntu-22.04/autoinstall-overlay.img
boot || goto menu

